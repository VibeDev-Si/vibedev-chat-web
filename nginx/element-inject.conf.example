# How VibeDev Chat serves Element Web 1.12.35 with the two compatibility scripts of this repository (nginx).
# Example only: names in CAPITALS are placeholders. Element itself runs unchanged (official image
# vectorim/element-web:v1.12.35) behind this proxy; TLS, caching, compression and other headers are left out here.

server {
    listen 443 ssl;
    server_name CHAT_HOST;                          # the chat site, for example chat.example.org

    # The scripts (compat/ of this repository). Versioned names: new content always gets a new name (v2, ...), so the
    # files can be cached for a long time.
    location = /vibedev-webrtc-compat-v1.js {
        root /PATH/TO/vibedev-chat-web/compat;
        default_type application/javascript;
        expires 1y;
        try_files $uri =404;
    }
    location = /vibedev-desktop-compat-v1.js {
        root /PATH/TO/vibedev-chat-web/compat;
        default_type application/javascript;
        expires 1y;
        try_files $uri =404;
    }

    # Everything else is Element Web. The only change to its pages: two <script defer> tags right after <head>
    # (sub_filter only rewrites text/html, i.e. index.html). The preconnect hint is unrelated to the scripts: Element's
    # cross-origin calls to the homeserver cannot reuse the page's connection, so one is opened early.
    location / {
        sub_filter_once on;
        sub_filter '<head>' '<head><link rel="preconnect" href="https://HOMESERVER_HOST" crossorigin><script defer src="/vibedev-webrtc-compat-v1.js"></script><script defer src="/vibedev-desktop-compat-v1.js"></script>';
        proxy_set_header Accept-Encoding "";        # sub_filter needs an uncompressed answer from Element
        proxy_pass http://ELEMENT_UPSTREAM;         # the Element Web container
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
